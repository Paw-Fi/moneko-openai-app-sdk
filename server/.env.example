# Supabase Edge Function Configuration
EDGE_BASE_URL=https://budgeting.moneko.io
EDGE_API_KEY=your_api_key_here

# Server Configuration
LOG_LEVEL=info
PORT=8000
# Bind address (use 0.0.0.0 in production containers)
HOST=127.0.0.1
# Optional: public base URL for serving widget assets (e.g. your ngrok URL, without /mcp)
# BASE_URL=https://your-public-host
# Optional: stable domain to attach to widgets for app submission (recommended for production)
# WIDGET_DOMAIN=https://moneko.io

# Auth (OAuth + Supabase)
# For embedded sign-in (recommended): keep connector as "No Auth" and set AUTH_REQUIRED=false.
# The tools will prompt users to sign in inside the widget and store a Supabase session per chat.
AUTH_REQUIRED=false

# Only needed if you choose connector auth = OAuth (optional)
WEB_BASE_URL=http://localhost:5173

# Supabase config (required for embedded sign-in widget + token verification)
BASE_URL=https://fce355fc2153.ngrok-free.app
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Optional: used to generate opaque expense refs so raw UUIDs never appear in tool calls.
# If omitted, the server falls back to SUPABASE_JWT_SECRET.
# MONEKO_REF_SECRET=your_random_secret
